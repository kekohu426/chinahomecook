generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id              String              @id @default(cuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  summary         Json?
  story           Json?
  ingredients     Json
  steps           Json

  viewCount       Int                 @default(0)
  aiGenerated     Boolean             @default(false)
  collectionId    String?
  cookTime        Int?
  coverImage      String?
  cuisineId       String?
  description     String?
  difficulty      String?
  generateJobId   String?
  locationId      String?
  nutrition       Json?
  prepTime        Int?
  publishedAt     DateTime?
  qualityScore    Json?
  reviewNote      String?
  reviewStatus    String              @default("pending")
  reviewedAt      DateTime?
  servings        String?
  slug            String              @unique
  status          String              @default("draft")
  title           String
  author          String?
  transStatus     Json                @default("{}")
  faq             Json?
  notes           Json?
  pairing         Json?
  relatedRecipes  Json?
  seo             Json?
  tips            Json?
  troubleshooting Json?
  explorerId      String?
  reviewerId      String?
  collection      Collection?         @relation(fields: [collectionId], references: [id])
  cuisine         Cuisine?            @relation(fields: [cuisineId], references: [id])
  explorer        TeamMember?         @relation("RecipeExplorer", fields: [explorerId], references: [id])
  location        Location?           @relation(fields: [locationId], references: [id])
  reviewer        TeamMember?         @relation("RecipeReviewer", fields: [reviewerId], references: [id])
  tags              RecipeTag[]
  translations      RecipeTranslation[]
  imageGenTasks     ImageGenTask[]
  customRecipeTasks CustomRecipeTask[]
  favorites         UserFavorite[]

  @@index([status, publishedAt])
  @@index([cuisineId])
  @@index([locationId])
  @@index([collectionId])
  @@index([slug])
  @@index([explorerId])
  @@index([reviewerId])
}

model RecipeTranslation {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  recipeId     String
  title        String
  slug         String
  description  String?
  difficulty   String?
  summary      Json?
  story        Json?
  ingredients  Json?
  steps        Json?
  transMethod  String?
  aiModel      String?
  aiPrompt     String?
  qualityScore Decimal?
  isReviewed   Boolean   @default(false)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  locale       String
  recipe       Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, locale])
  @@index([locale])
  @@index([recipeId])
}

model Collection {
  id                   String                  @id @default(cuid())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  type                 String
  name                 String
  slug                 String                  @unique
  path                 String
  description          String?
  coverImage           String?
  status               String                  @default("draft")
  isFeatured           Boolean                 @default(false)
  minRequired          Int                     @default(20)
  targetCount          Int                     @default(60)
  rules                Json                    @default("{}")
  pinnedRecipeIds      String[]                @default([])
  excludedRecipeIds    String[]                @default([])
  seo                  Json                    @default("{}")
  transStatus          Json                    @default("{}")
  cuisineId            String?                 @unique
  locationId           String?                 @unique
  cachedAt             DateTime?
  cachedMatchedCount   Int                     @default(0)
  cachedPendingCount   Int                     @default(0)
  cachedPublishedCount Int                     @default(0)
  descriptionEn        String?
  nameEn               String?
  publishedAt          DateTime?
  ruleType             String                  @default("auto")
  sortOrder            Int                     @default(0)
  tagId                String?                 @unique
  lastViewedAt         DateTime?
  viewCount            Int                     @default(0)
  cuisine              Cuisine?                @relation(fields: [cuisineId], references: [id])
  location             Location?               @relation(fields: [locationId], references: [id])
  tag                  Tag?                    @relation(fields: [tagId], references: [id])
  translations         CollectionTranslation[]
  recipes              Recipe[]

  @@index([type, status])
  @@index([status, cachedPublishedCount])
  @@index([slug])
  @@index([sortOrder])
}

model CollectionTranslation {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collectionId String
  name         String
  slug         String
  description  String?
  seo          Json?
  transMethod  String?
  isReviewed   Boolean    @default(false)
  locale       String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
}

model Cuisine {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  name         String               @unique
  slug         String               @unique
  description  String?
  icon         String?
  sortOrder    Int                  @default(0)
  isActive     Boolean              @default(true)
  transStatus  Json                 @default("{}")
  collection   Collection?
  translations CuisineTranslation[]
  recipes      Recipe[]

  @@index([isActive, sortOrder])
}

model CuisineTranslation {
  id          String   @id @default(cuid())
  cuisineId   String
  name        String
  slug        String
  description String?
  locale      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cuisine     Cuisine  @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@unique([cuisineId, locale])
  @@index([locale])
}

model Location {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  name         String                @unique
  slug         String                @unique
  description  String?
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  transStatus  Json                  @default("{}")
  collection   Collection?
  translations LocationTranslation[]
  recipes      Recipe[]

  @@index([isActive, sortOrder])
}

model LocationTranslation {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  slug        String
  description String?
  locale      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, locale])
  @@index([locale])
}

model Tag {
  id           String           @id @default(cuid())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  type         String
  name         String
  slug         String           @unique
  icon         String?
  color        String?
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  transStatus  Json             @default("{}")
  collection   Collection?
  recipes      RecipeTag[]
  translations TagTranslation[]

  @@unique([type, name])
  @@index([type, isActive])
}

model TagTranslation {
  id        String   @id @default(cuid())
  tagId     String
  name      String
  slug      String
  locale    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@index([locale])
}

model RecipeTag {
  recipeId  String
  tagId     String
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

model Ingredient {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  name         String                  @unique
  category     String?
  unit         String?
  iconKey      String?
  iconUrl      String?
  transStatus  Json                    @default("{}")
  translations IngredientTranslation[]

  @@index([category])
}

model IngredientTranslation {
  id           String     @id @default(cuid())
  ingredientId String
  name         String
  unit         String?
  locale       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, locale])
  @@index([locale])
}

model GenerateJob {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sourceType   String
  collectionId String?
  lockedTags   Json
  recipeNames  String[]
  qualityLevel String    @default("high")
  reviewMode   String    @default("ai_human")
  status       String    @default("pending")
  totalCount   Int       @default(0)
  successCount Int       @default(0)
  failedCount  Int       @default(0)
  results      Json      @default("[]")
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status])
  @@index([collectionId])
}

model TranslationJob {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  entityType   String
  entityId     String
  targetLang   String
  status       String    @default("pending")
  priority     Int       @default(5)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  result       Json?
  qualityScore Decimal?

  @@index([status, priority])
  @@index([entityType, entityId])
}

model AIConfig {
  id                  String   @id @default("default")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  textProvider        String?
  textApiKey          String?
  textBaseUrl         String?
  textModel           String?
  imageProvider       String?
  imageApiKey         String?
  imageBaseUrl        String?
  imageModel          String?
  imageNegativePrompt String?
  transProvider       String?
  transApiKey         String?
  transBaseUrl        String?
  transModel          String?
  recipePrompt        String?
  recipeSystemPrompt  String?
  transPrompt         String?
  seoPrompt           String?
}

model AIPrompt {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  category     String
  prompt       String
  systemPrompt String?
  variables    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model SiteConfig {
  id             String   @id @default("default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  siteName       Json?
  siteDesc       Json?
  defaultLang    String   @default("en")
  supportedLangs String[] @default(["en", "zh"])
  autoTranslate  Boolean  @default(true)
  transOnPublish Boolean  @default(true)
}

model HomeConfig {
  id              String                  @id @default(cuid())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  section         String
  sortOrder       Int                     @default(0)
  isActive        Boolean                 @default(true)
  title           String?
  subtitle        String?
  content         Json?
  recipeIds       String[]
  collectionIds   String[]
  backgroundImage String?
  transStatus     Json                    @default("{}")
  translations    HomeConfigTranslation[]

  @@index([section, isActive])
}

model HomeConfigTranslation {
  id        String     @id @default(cuid())
  configId  String
  title     String?
  subtitle  String?
  content   Json?
  locale    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  config    HomeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, locale])
  @@index([locale])
}

model HomeBrowseItem {
  id           String                      @id @default(cuid())
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  type         String
  name         String
  description  String?
  href         String
  imageUrl     String?
  sortOrder    Int                         @default(0)
  isActive     Boolean                     @default(true)
  transStatus  Json                        @default("{}")
  translations HomeBrowseItemTranslation[]

  @@index([type, isActive])
}

model HomeBrowseItemTranslation {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  itemId      String
  locale      String
  name        String?
  description String?
  item        HomeBrowseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
  @@index([locale])
}

model HomeThemeCard {
  id           String                     @id @default(cuid())
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  title        String
  tag          String
  imageUrl     String
  href         String?
  sortOrder    Int                        @default(0)
  isActive     Boolean                    @default(true)
  transStatus  Json                       @default("{}")
  translations HomeThemeCardTranslation[]

  @@index([isActive])
}

model HomeThemeCardTranslation {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cardId    String
  locale    String
  title     String?
  card      HomeThemeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, locale])
  @@index([locale])
}

model HomeTestimonial {
  id           String                       @id @default(cuid())
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  name         String
  role         String
  city         String
  content      String
  meta         String
  avatarUrl    String?
  sortOrder    Int                          @default(0)
  isActive     Boolean                      @default(true)
  transStatus  Json                         @default("{}")
  translations HomeTestimonialTranslation[]

  @@index([isActive])
}

model HomeTestimonialTranslation {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  testimonialId String
  locale        String
  name          String?
  role          String?
  city          String?
  content       String?
  meta          String?
  testimonial   HomeTestimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, locale])
  @@index([locale])
}

model User {
  id                String              @id @default(cuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  email             String              @unique
  passwordHash      String
  name              String?
  role              String              @default("user")
  favorites         UserFavorite[]
  customRecipeTasks CustomRecipeTask[]

  @@index([email])
}

// 用户收藏食谱
model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

model AIConversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  recipeId      String
  recipeTitleZh String
  messages      Json

  @@index([recipeId])
  @@index([createdAt])
}

model AIGenerationLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  sessionId    String   @map("session_id")
  stepName     String   @map("step_name")
  timestamp    DateTime @default(now())
  modelName    String   @map("model_name")
  provider     String?
  status       String
  prompt       String?
  promptUrl    String?  @map("prompt_url")
  parameters   Json?
  result       Json?
  resultUrl    String?  @map("result_url")
  resultText   String?  @map("result_text")
  resultImages String[] @map("result_images")
  durationMs   Int?     @map("duration_ms")
  tokenUsage   Json?    @map("token_usage")
  cost         Float?
  retryIndex   Int?     @map("retry_index")
  recipeId     String?  @map("recipe_id")
  jobId        String?  @map("job_id")
  userId       String?  @map("user_id")
  errorMessage String?  @map("error_message")
  errorStack   String?  @map("error_stack")
  warning      String?
  metadata     Json?

  @@index([sessionId])
  @@index([timestamp])
  @@index([modelName])
  @@index([status])
  @@index([stepName])
  @@index([recipeId])
  @@index([jobId])
  @@map("ai_generation_logs")
}

model AboutSection {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  titleZh      String
  contentZh    String
  type         String                    @default("text")
  imageUrl     String?
  videoUrl     String?
  sortOrder    Int                       @default(0)
  isActive     Boolean                   @default(true)
  translations AboutSectionTranslation[]

  @@index([sortOrder])
  @@index([isActive])
}

model AboutSectionTranslation {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sectionId String
  locale    String
  title     String
  content   String
  section   AboutSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@index([locale])
}

model TeamMember {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  slug                  String   @unique
  nameZh                String
  nameEn                String
  role                  String
  bioZh                 String?
  bioEn                 String?
  mottoZh               String?
  mottoEn               String?
  avatarUrl             String?
  specialtyCuisines     String[]
  specialtyRegions      String[]
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  assignedExplorerCount Int      @default(0)
  assignedReviewerCount Int      @default(0)
  exploredRecipes       Recipe[] @relation("RecipeExplorer")
  reviewedRecipes       Recipe[] @relation("RecipeReviewer")

  @@index([role, isActive])
  @@index([sortOrder])
}

// 图片生成任务（步骤图 + 成品图）
model ImageGenTask {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  recipeId     String?   // 关联食谱（可选）
  recipeName   String    // 食谱名称
  dishStyle    String    @default("dark_and_moody") // light_and_fresh/dark_and_moody/baking

  // 步骤图信息
  steps        Json      // [{number, description, title?, action?}]
  prompts      Json?     // StepPrompt[] - 步骤图提示词
  images       Json?     // [{stepNumber, imageUrl, error?}] - 步骤图结果

  // 成品图信息
  imageShots   Json?     // [{key, ratio, imagePrompt?}] - 成品图配置
  shotPrompts  Json?     // [{key, ratio, imagePrompt}] - 成品图提示词
  shotImages   Json?     // [{key, ratio, imageUrl, error?}] - 成品图结果

  // 封面图（从成品图中选择）
  coverImageUrl String?

  // 任务状态: pending/generating_prompts/generating_images/completed/failed
  status       String    @default("pending")
  errorMessage String?

  // 创建形式: auto_generate(菜谱生成) / manual(手动创建) / batch(批量任务) / import(导入)
  source       String    @default("auto_generate")

  // 进度跟踪 - 步骤图
  totalSteps   Int       @default(0)
  promptsDone  Int       @default(0)
  imagesDone   Int       @default(0)

  // 进度跟踪 - 成品图
  totalShots   Int       @default(0)
  shotsDone    Int       @default(0)

  // 时间戳
  startedAt    DateTime?
  completedAt  DateTime?

  // 关联
  recipe       Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([recipeId])
  @@index([createdAt])
}

// 定制食谱生成任务
model CustomRecipeTask {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String    // 关联用户
  userPrompt    String    // 用户需求描述
  recipeName    String    // 食谱名称

  recipeId      String?   // 生成的食谱ID
  imageTaskId   String?   // 关联的图片任务ID

  // 状态: pending → recipe_generating → recipe_done →
  //       prompts_generating → images_generating → reviewing → completed
  status        String    @default("pending")

  currentPhase  Int       @default(0) // 当前阶段 0-6
  totalPhases   Int       @default(7)
  phaseProgress Int       @default(0) // 阶段内进度 0-100

  totalImages   Int       @default(0)
  imagesDone    Int       @default(0)

  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe        Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// 博客文章
model BlogPost {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  title        String
  slug         String               @unique
  content      String?
  excerpt      String?
  coverImage   String?
  status       String               @default("draft")
  publishedAt  DateTime?
  viewCount    Int                  @default(0)
  author       String?
  transStatus  Json                 @default("{}")
  seo          Json?
  translations BlogPostTranslation[]

  @@index([status, publishedAt])
  @@index([slug])
}

// 博客翻译
model BlogPostTranslation {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  postId      String
  locale      String
  title       String
  slug        String
  content     String?
  excerpt     String?
  transMethod String?
  isReviewed  Boolean  @default(false)
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
}

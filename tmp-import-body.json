Brief": "", "heat": "medium", "timeMin": 5, "timeMax": 7, "statusChecks": [], "failurePoints": [], "recovery": "若偏稀，可延长炒制并略加番茄膏增强浓度。", "safeNote": null, "imagePrompt": "", "negativePrompt": "", "ingredientRefs": [], "equipmentRefs": []}, {"id": "step03", "title": "炖煮牛肉番茄汤", "action": "把炒好的番茄倒入汤锅，加入焯过的牛肉与清水/高汤、生抽、料酒、少许糖与盐；大火煮沸后改小火加盖炖40–50分钟至牛肉软弹入味。", "speechText": "", "timerSec": 0, "visualCue": "汤色红润、牛肉易穿透不散", "failPoint": "水量不足易糊锅；过度大火会使肉质粗糙", "photoBrief": "", "heat": "low", "timeMin": 40, "timeMax": 50, "statusChecks": [], "failurePoints": [], "recovery": "若味淡可在后段补少量生抽；若偏酸，少量加糖平衡。", "safeNote": null, "imagePrompt": "", "negativePrompt": "", "ingredientRefs": [], "equipmentRefs": []}, {"id": "step04", "title": "煮面与合拢", "action": "另起锅煮面至八成熟捞出；将面入番茄牛肉汤中再煮1分钟，使面吸汤；撒白胡椒，按口味再调盐。", "speechText": "", "timerSec": 0, "visualCue": "面条柔软有弹性、汤汁均匀裹面", "failPoint": "面煮过久会发胀变软", "photoBrief": "", "heat": "medium", "timeMin": 3, "timeMax": 5, "statusChecks": [], "failurePoints": [], "recovery": "若面过软，可改用新面条或缩短吸汤时长。", "safeNote": null, "imagePrompt": "", "negativePrompt": "", "ingredientRefs": [], "equipmentRefs": []}, {"id": "step05", "title": "出锅点缀", "action": "盛入碗中，撒香菜或葱花点缀，趁热享用。", "speechText": "", "timerSec": 0, "visualCue": "汤面红亮、香草点缀、牛肉块饱满", "failPoint": "", "photoBrief": "", "heat": "low", "timeMin": 1, "timeMax": 2, "statusChecks": [], "failurePoints": [], "recovery": "", "safeNote": null, "imagePrompt": "", "negativePrompt": "", "ingredientRefs": [], "equipmentRefs": []}], "faq": [{"question": "可以用高压锅吗？", "answer": "可以。牛肉上压约20分钟更省时，之后再与番茄合煮5–10分钟调整味道。"}, {"question": "番茄罐头可以替代鲜番茄吗？", "answer": "可以，用去皮整粒番茄罐头更易出红油，需适度加糖平衡酸度。"}, {"question": "面条选粗还是细？", "answer": "细面更易吸汤，粗面更耐煮且口感更劲道，按个人偏好选择。"}], "tips": ["番茄需炒至出红油再加水，汤色与风味更浓郁。", "牛肉先焯水再炖，口感更干净、汤更清亮。", "汤底若想更醇，可改用鸡汤或加入少量骨汤。"], "troubleshooting": [{"problem": "汤色不红", "cause": "番茄未炒出红油或番茄浓度不足", "fix": "延长炒制并补1汤匙番茄膏提升颜色与浓度。"}, {"problem": "过酸", "cause": "番茄酸度高或糖不足", "fix": "少量加糖与延长炖煮时间，使酸度趋于柔和。"}, {"problem": "牛肉偏柴", "cause": "
{"recipes": [{"id": "", "titleZh": "糖醋排骨", "titleEn": "Sweet and Sour Pork Ribs", "aliases": ["锅包排骨（家常糖醋版）", "陈醋糖排"], "primaryIngredients": ["猪小排"], "origin": {"country": "中国", "region": "江浙/沪", "cuisine": "家常菜", "notes": "糖醋类菜式在江南与沪菜中常见，此版本为家常不油炸做法。"}, "summary": {"oneLine": "酸甜开胃、外酥里嫩、极下饭的经典家常菜。", "healingTone": "酸甜的平衡，像日常里的温柔安慰。", "flavorTags": ["酸甜", "咸香", "下饭"], "difficulty": "medium", "timeTotalMin": 55, "timeActiveMin": 30, "servings": 4, "scaleHint": "按人数等比例增加排骨与调味，保持酸甜比例不变。"}, "story": "糖醋排骨是很多人童年的味道：金红亮泽的酱汁包裹着排骨，酸甜恰到好处，配一碗白米饭，简单却无可替代。", "culturalStory": "“糖醋”在江南菜系中是一种典型口味，通过糖与醋的平衡呈现开胃、提鲜的效果。不同家庭有各自的比例与做法，形成丰富多样的家常风味。", "nutrition": {"perServing": {"calories": 520, "protein": 24, "fat": 34, "carbs": 28, "fiber": 1, "sodium": 950}, "dietaryLabels": ["不适合素食", "含猪肉", "可能含麸质（酱油）"], "disclaimer": "营养为估算值，实际数值会因食材品牌与用量变化。若需低钠/低糖，请调整酱油与糖的用量。"}, "equipment": [{"name": "菜刀", "required": true, "notes": "剁排骨与切葱姜"}, {"name": "案板", "required": true, "notes": ""}, {"name": "深锅（砂锅或汤锅）", "required": true, "notes": "焯水与前期炖煮"}, {"name": "炒锅/不粘锅", "required": true, "notes": "收汁与上色"}, {"name": "漏勺", "required": false, "notes": "捞出控水"}], "ingredients": [{"section": "主料", "items": [{"name": "猪小排（肋排）", "iconKey": "meat", "amount": 800, "unit": "克", "prep": "剁成3–4厘米段、清洗去血水", "optional": false, "substitutes": ["猪肋条（带骨）"], "allergens": [], "notes": "选小排更嫩，尽量带少量软骨口感更好。"}]}, {"section": "配料与调味", "items": [{"name": "葱段", "iconKey": "veg", "amount": 20, "unit": "克", "prep": "切段", "optional": true, "substitutes": ["香葱"], "allergens": [], "notes": ""}, {"name": "姜片", "iconKey": "veg", "amount": 15, "unit": "克", "prep": "切片", "optional": false, "substitutes": [], "allergens": [], "notes": ""}, {"name": "蒜瓣", "iconKey": "veg", "amount": 3, "unit": "瓣", "prep": "拍碎", "optional": true, "substitutes": [], "allergens": [], "notes": ""}, {"name": "冰糖/白砂糖", "iconKey": "condiment", "amount": 35, "unit": "克", "prep": "", "optional": false, "substitutes": ["黄冰糖", "白砂糖+少许麦芽糖"], "allergens": [], "notes": "冰糖上色更通透。"}, {"name": "陈醋（或镇江香醋）", "iconKey": "condiment", "amount": 35, "unit": "毫升", "prep": "", "optional": false, "substitutes": ["米醋（风味较清）", "黑醋"], "allergens": [], "notes": "优选陈醋更具层次。"}, {"name": "生抽", "iconKey": "condiment", "amount": 25, "unit": "毫升", "prep": "", "optional": false, "substitutes": ["淡酱油"], "allergens": ["大豆", "麸质（部分品牌）"], "notes": "提供咸鲜与底味。"}, {"name": "老抽", "iconKey": "condiment", "amount": 8, "unit": "毫升", "prep": "", "optional": true, "substitutes": [], "allergens": ["大豆", "麸质（部分品牌）"], "notes": "少量用于上色。"}, {"name": "料酒", "iconKey": "condiment", "amount": 30, "unit": "毫升", "prep": "", "optional": false, "substitutes": ["黄酒", "干白葡萄酒（少量）"], "allergens": [], "notes": "去腥提香。"}, {"name": "盐", "iconKey": "condiment", "amount": 2, "unit": "克", "prep": "", "optional": true, "substitutes": [], "allergens": [], "notes": "视生抽咸度酌减。"}, {"name": "清水", "iconKey": "condiment", "amount": 300, "unit": "毫升", "prep": "", "optional": false, "substitutes": ["高汤（更香）"], "allergens": [], "notes": ""}, {"name": "白芝麻", "iconKey": "condiment", "amount": 1, "unit": "汤匙", "prep": "炒香", "optional": true, "substitutes": [], "allergens": [], "notes": "用于出锅点缀。"}]}], "steps": [{"id": "step01", "title": "焯水去腥", "action": "锅中加冷水放入排骨、姜片与少量料酒，中火加热至沸，撇去浮沫后再煮2分钟，捞出用温水洗净沥干。", "speechText": "", "timerSec": 0, "visualCue": "血沫被撇净，排骨色泽由红转浅", "failPoint": "未撇净浮沫会有异味", "photoBrief": "", "heat": "medium", "timeMin": 5, "timeMax": 8, "statusChecks": [], "failurePoints": [], "recovery": "若有浮沫残留，再次温水冲洗排骨。"}, {"id": "step02", "title": "煸香与上色", "action": "炒锅小火加少许油，下姜片、蒜拍碎、葱段炒香；改中火下排骨翻炒至表面微焦。加入生抽、老抽、料酒翻匀，让排骨均匀上色。", "speechText": "", "timerSec": 0, "visualCue": "排骨表面微焦亮，香气扑鼻", "failPoint": "火过大易糊苦", "photoBrief": "", "heat": "medium", "timeMin": 5, "timeMax": 7, "statusChecks": [], "failurePoints": [], "recovery": "若糊点，迅速捞出糊料，转新锅继续。"}, {"id": "step03", "title": "糖醋调味与炖煮", "action": "加入清水（约300毫升）、冰糖、陈醋、少许盐，大火煮沸后转小火加盖焖煮20–25分钟至排骨软烂。", "speechText": "", "timerSec": 0, "visualCue": "汤色红亮、排骨软而不散", "failPoint": "水少易糊锅；水多味淡", "photoBrief": "", "heat": "low", "timeMin": 20, "timeMax": 25, "statusChecks": [], "failurePoints": [], "recovery": "若味淡，后续收汁时补少量生抽与糖。"}, {"id": "step04", "title": "大火收汁成糖醋芡", "action": "开大火，持续翻拌，使酱汁浓稠裹在排骨表面；根据口味微调糖或醋。收至汁液黏亮、能挂筷即关火。", "speechText": "", "timerSec": 0, "visualCue": "酱汁黏稠、光泽亮丽、能均匀挂在排骨上", "failPoint": "收汁过头会发黏或焦苦", "photoBrief": "", "heat": "high", "timeMin": 3, "timeMax": 6, "statusChecks": [], "failurePoints": [], "recovery": "若过稠，可补1–2汤匙清水，快速翻匀。"}, {"id": "step05", "title": "装盘与点缀", "action": "出锅后撒少许炒香白芝麻点缀，上桌即可。", "speechText": "", "timerSec": 0, "visualCue": "表面芝麻均匀，糖醋汁光亮诱人", "failPoint": "", "photoBrief": "", "heat": "low", "timeMin": 1, "timeMax": 2, "statusChecks": [], "failurePoints": [], "recovery": ""}], "faq": [{"question": "能否不用老抽？", "answer": "可以，老抽主要用于上色，不影响核心酸甜风味。"}, {"question": "可不焯水吗？", "answer": "不建议。焯水能去血沫与异味，使口感更干净。"}, {"question": "冰糖与白砂糖差别大吗？", "answer": "冰糖更易产生通透亮泽的色泽，白砂糖也可用但风味略直。"}], "tips": ["家常黄金比例参考：糖≈35g、醋≈35ml、生抽≈25ml、料酒≈30ml、清水≈300ml；依据个人口味微调。", "收汁时保持翻拌，使酱汁均匀包裹排骨，避免局部糊锅。", "用陈醋风味更厚重，用米醋则更清爽；二者可按3:2混合取得平衡。"], "troubleshooting": [{"problem": "过甜或腻", "cause": "糖用量偏高或收汁过度", "fix": "补少量陈醋与清水，快速翻匀稀释平衡。"}, {"problem": "过酸刺喉", "cause": "醋添加偏多或酸甜未平衡", "fix": "小量加糖与水，边收边调整至顺口。"}, {"problem": "酱汁发苦", "cause": "炒糊或老抽过量", "fix": "换锅后补水与糖，快速收至黏亮，控制火力。"}], "relatedRecipes": {"similar": ["陈醋排骨", "红烧排骨"], "pairing": ["白米饭"]}, "pairing": {"suggestions": ["白米饭", "清炒青菜", "凉拌黄瓜"], "sauceOrSide": ["葱油小菜", "清汤"]}, "tags": {"scenes": ["家常菜", "下饭菜"], "cookingMethods": ["焯", "煸", "焖", "收汁"], "tastes": ["酸甜", "咸香"], "crowds": ["所有人"], "occasions": ["正餐", "家庭聚餐"]}, "seo": {"slug": "tang-cu-paigu", "metaTitle": "糖醋排骨 | 家常酸甜下饭菜", "metaDescription": "经典家常糖醋排骨做法：焯水去腥、煸香上色、焖煮入味、大火收汁，酸甜平衡、红亮诱人，配米饭超下饭。", "keywords": ["糖醋排骨", "家常菜", "酸甜", "下饭"]}, "notes": [], "schemaVersion": "2.0.0"}, {"id": "", "titleZh": "番茄牛肉面", "titleEn": "Tomato Beef Noodles", "aliases": ["番茄牛腩面", "西红柿牛肉面"], "primaryIngredients": ["番茄", "牛肉", "面条"], "origin": {"country": "中国", "region": "北方家常", "cuisine": "家常面食", "notes": "以番茄的酸甜调和牛肉的浓香，做成一碗红润鲜亮、汤面合一的家常面。"}, "summary": {"oneLine": "红润酸甜、鲜香浓郁的一碗家常牛肉面。", "healingTone": "番茄的果香包裹牛肉的暖意，治愈而踏实。", "flavorTags": ["酸甜", "番茄香", "牛肉汤"], "difficulty": "medium", "timeTotalMin": 75, "timeActiveMin": 35, "servings": 3, "scaleHint": "按人数等比例增加番茄、牛肉与面条，保持番茄与汤水比例不变。"}, "story": "一碗番茄牛肉面，红润的汤色来自慢炖出的番茄果胶与牛肉的肉汁，酸甜开胃，醇厚不腻，适合忙碌日子里给自己一点温柔的补给。", "culturalStory": "番茄入菜在中国南北皆常见，配面更受欢迎。牛肉面源流多样，而番茄版以酸甜提升鲜感，适口度高，老少皆宜。", "nutrition": {"perServing": {"calories": 620, "protein": 35, "fat": 22, "carbs": 70, "fiber": 5, "sodium": 1200}, "dietaryLabels": ["含牛肉", "非素食"], "disclaimer": "营养为估算值，实际数值随食材与品牌波动。若需低钠，请减少酱油与盐；需低脂可改用牛腱并控油。"}, "equipment": [{"name": "菜刀", "required": true, "notes": "切牛肉与番茄"}, {"name": "案板", "required": true, "notes": ""}, {"name": "汤锅/砂锅", "required": true, "notes": "炖牛肉与煮汤"}, {"name": "炒锅", "required": true, "notes": "番茄炒出红油与整合汤底"}, {"name": "漏勺", "required": false, "notes": "捞面控水"}], "ingredients": [{"section": "主料", "items": [{"name": "牛腩（或牛肩肉）", "iconKey": "meat", "amount": 600, "unit": "克", "prep": "切3厘米方块，冷水浸10分钟去血水", "optional": false, "substitutes": ["牛腱", "牛前胸"], "allergens": [], "notes": "含筋肉更易出胶质口感。"}, {"name": "番茄（西红柿）", "iconKey": "veg", "amount": 600, "unit": "克", "prep": "去蒂切块；另备1个切丁用于出红油", "optional": false, "substitutes": ["番茄罐头（去皮整粒，400g）"], "allergens": [], "notes": "成熟番茄更甜更香。"}, {"name": "面条（拉面/阳春面/挂面）", "iconKey": "grain", "amount": 450, "unit": "克", "prep": "按人数分份", "optional": false, "substitutes": ["乌冬面", "意面（口感不同）"], "allergens": ["麸质（小麦）"], "notes": "偏细面更易吸汤。"}]}, {"section": "配料与调味", "items": [{"name": "洋葱", "iconKey": "veg", "amount": 100, "unit": "克", "prep": "切丝", "optional": true, "substitutes": ["葱段"], "allergens": [], "notes": "提升甜与香气。"}, {"name": "姜片", "iconKey": "veg", "amount": 20, "unit": "克", "prep": "切片", "optional": false, "substitutes": [], "allergens": [], "notes": ""}, {"name": "蒜瓣", "iconKey": "veg", "amount": 4, "unit": "瓣", "prep": "拍